# ==== eSoccer Radar — configuración ====
# Copia a ".env" y rellena. El .env NUNCA se sube (está en .gitignore).

# Bot NUEVO (creado con @BotFather), distinto al de Radar Rojo
TELEGRAM_BOT_TOKEN=pega_aqui_el_token_del_bot_nuevo

# ID del CANAL de eSoccer — análisis de partidos (número -100..., de @getidsbot)
TELEGRAM_CHAT_ID=pega_aqui_el_id_del_canal

# ID del canal SOLO para reportes de tasa de acierto (opcional). Si lo dejas
# vacío, los reportes van al mismo canal de arriba.
TELEGRAM_REPORTS_CHAT_ID=

# Tu id de usuario de Telegram (de @getidsbot, escribiéndole tú directamente).
# SOLO este usuario puede pedir reportes por comando (/semana, /mes...). Si lo
# dejas vacío, cualquiera que le escriba al bot podría pedirlos.
TELEGRAM_OWNER_ID=

# Cada cuánto se revisan los próximos partidos (segundos)
POLL_INTERVAL_SECONDS=60
