# ==== eSoccer Radar — configuración ====
# Copia a ".env" y rellena. El .env NUNCA se sube (está en .gitignore).

# Bot NUEVO (creado con @BotFather), distinto al de Radar Rojo
TELEGRAM_BOT_TOKEN=pega_aqui_el_token_del_bot_nuevo

# ID del CANAL de eSoccer (número que empieza por -100..., de @getidsbot)
TELEGRAM_CHAT_ID=pega_aqui_el_id_del_canal

# Cada cuánto se revisan los próximos partidos (segundos)
POLL_INTERVAL_SECONDS=60
